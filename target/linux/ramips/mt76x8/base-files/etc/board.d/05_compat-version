
. /lib/functions.sh
. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
	tplink,re305-v1)
		ucidef_set_compat_version "2.0"
		;;
	hiwooya,neo-router|\
	zbtlink,zbt-cpe2801-16m|\
	zbtlink,zbt-cpe2801-32m|\
	zbtlink,zbt-we2802d-8m|\
	zbtlink,zbt-we2802d-16m|\
	)
		ucidef_set_compat_version "1.1"
		;;
esac

board_config_flush

exit 0
