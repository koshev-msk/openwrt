+#ifdef APK_CRYPTO_WOLFSSL
+/*
+ * The key id is a hash of i2d_PublicKey() output, which in OpenSSL is the bare
+ * key material (RSAPublicKey / EC point). Recent wolfSSL returns a full
+ * SubjectPublicKeyInfo there instead, so unwrap the subjectPublicKey BIT
+ * STRING of the SPKI to get the same bytes as OpenSSL.
+ */
+static int der_hdr(const unsigned char **p, const unsigned char *end, unsigned char tag, size_t *len)
+{
+	size_t l;
+
+	if (*p >= end || **p != tag) return -1;
+	(*p)++;
+	if (*p >= end) return -1;
+	l = *(*p)++;
+	if (l & 0x80) {
+		int nb = l & 0x7f;
+		if (nb < 1 || nb > 2 || end - *p < nb) return -1;
+		for (l = 0; nb--; ) l = l << 8 | *(*p)++;
+	}
+	if (l > (size_t)(end - *p)) return -1;
+	*len = l;
+	return 0;
+}
+
+static int apk_i2d_publickey(EVP_PKEY *key, unsigned char **pub)
+{
+	unsigned char *spki = NULL;
+	const unsigned char *p, *end;
+	size_t l;
+	int n, r = -1;
+
+	if ((n = i2d_PUBKEY(key, &spki)) <= 0) return i2d_PublicKey(key, pub);
+	p = spki;
+	end = spki + n;
+	if (der_hdr(&p, end, 0x30, &l) == 0 &&			/* SubjectPublicKeyInfo */
+	    der_hdr(&p, end, 0x30, &l) == 0 &&			/* AlgorithmIdentifier */
+	    (p += l, der_hdr(&p, end, 0x03, &l)) == 0 &&	/* subjectPublicKey */
+	    l > 1 && *p == 0) {
+		p++;
+		l--;
+		if ((*pub = OPENSSL_malloc(l)) != NULL) {
+			memcpy(*pub, p, l);
+			r = (int)l;
+		}
+	}
+	OPENSSL_free(spki);
+	return r < 0 ? i2d_PublicKey(key, pub) : r;
+}
+#else
+#define apk_i2d_publickey i2d_PublicKey
+#endif
+
 static int apk_pkey_init(struct apk_pkey *pkey, EVP_PKEY *key)
 {
 	unsigned char dig[EVP_MAX_MD_SIZE], *pub = NULL;
@@ -171,7 +240,7 @@ static int apk_pkey_init(struct apk_pkey *pkey, EVP_PKEY *key)
