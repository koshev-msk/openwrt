+/* Checks to see if a key management algorithm is fetchable from a provider */
+static int is_keymgmt_fetchable(SSL_CTX *ctx, const char *name)
+{
+    EVP_KEYMGMT *impl;
+
+    ERR_set_mark();
+    impl = EVP_KEYMGMT_fetch(ctx->libctx, name, ctx->propq);
+    ERR_pop_to_mark();
+    if (impl == NULL)
+        return 0;
+    EVP_KEYMGMT_free(impl);
+    return 1;
+}
