+static void netlink_parse_geoip(struct netlink_parse_ctx *ctx,
+				const struct location *loc,
+				const struct nftnl_expr *nle)
+{
+	const char *cc;
+	uint32_t len = 0, i;
+	struct stmt *stmt;
+
+	stmt = geoip_stmt_alloc(loc);
+	stmt->geoip.flags = nftnl_expr_get_u32(nle, NFTNL_EXPR_GEOIP_FLAGS);
+
+	cc = nftnl_expr_get(nle, NFTNL_EXPR_GEOIP_CC, &len);
+	for (i = 0; cc && i + 1 < len && stmt->geoip.count < NFT_GEOIP_MAX;
+	     i += 2) {
+		stmt->geoip.cc[stmt->geoip.count][0] = cc[i];
+		stmt->geoip.cc[stmt->geoip.count][1] = cc[i + 1];
+		stmt->geoip.count++;
+	}
+
+	ctx->stmt = stmt;
+}
