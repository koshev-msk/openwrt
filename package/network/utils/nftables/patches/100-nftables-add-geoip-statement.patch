+static struct nftnl_expr *netlink_gen_geoip_stmt(const struct stmt *stmt)
+{
+	struct nftnl_expr *nle;
+	char cc[NFT_GEOIP_MAX * 2];
+	unsigned int i;
+
+	for (i = 0; i < stmt->geoip.count; i++) {
+		cc[2 * i] = stmt->geoip.cc[i][0];
+		cc[2 * i + 1] = stmt->geoip.cc[i][1];
+	}
+
+	nle = alloc_nft_expr("geoip");
+	nftnl_expr_set_u32(nle, NFTNL_EXPR_GEOIP_FLAGS, stmt->geoip.flags);
+	nftnl_expr_set(nle, NFTNL_EXPR_GEOIP_CC, cc, stmt->geoip.count * 2);
+
+	return nle;
+}
