+
+static void geoip_stmt_print(const struct stmt *stmt, struct output_ctx *octx)
+{
+	unsigned int i;
+
+	nft_print(octx, "geoip %s %s",
+		  stmt->geoip.flags & NFT_GEOIP_F_DST ? "daddr" : "saddr",
+		  stmt->geoip.flags & NFT_GEOIP_F_INV ? "!= " : "");
+
+	for (i = 0; i < stmt->geoip.count; i++)
+		nft_print(octx, "%s%c%c", i ? "," : "",
+			  stmt->geoip.cc[i][0], stmt->geoip.cc[i][1]);
+}
+
+static const struct stmt_ops geoip_stmt_ops = {
+	.type		= STMT_GEOIP,
+	.name		= "geoip",
+	.print		= geoip_stmt_print,
+	.json		= geoip_stmt_json,
+};
+
+struct stmt *geoip_stmt_alloc(const struct location *loc)
+{
+	return stmt_alloc(loc, &geoip_stmt_ops);
+}
+
+/* returns 0 on success, -1 for a malformed code, -2 for too many countries */
+int geoip_stmt_add_cc(struct stmt *stmt, const char *cc)
+{
+	char c[2];
+	unsigned int i, j;
+
+	for (i = 0; i < 2; i++) {
+		c[i] = cc[i];
+		if (c[i] >= 'a' && c[i] <= 'z')
+			c[i] -= 'a' - 'A';
+		if (!((c[i] >= 'A' && c[i] <= 'Z') ||
+		      (c[i] >= '0' && c[i] <= '9')))
+			return -1;
+	}
+	if (cc[2] != '\0')
+		return -1;
+
+	for (j = 0; j < stmt->geoip.count; j++) {
+		if (stmt->geoip.cc[j][0] == c[0] &&
+		    stmt->geoip.cc[j][1] == c[1])
+			return 0;
+	}
+	if (stmt->geoip.count >= NFT_GEOIP_MAX)
+		return -2;
+
+	stmt->geoip.cc[stmt->geoip.count][0] = c[0];
+	stmt->geoip.cc[stmt->geoip.count][1] = c[1];
+	stmt->geoip.count++;
+	return 0;
 }
 
