+json_t *geoip_stmt_json(const struct stmt *stmt, struct output_ctx *octx)
+{
+	json_t *cc = json_array();
+	unsigned int i;
+
+	for (i = 0; i < stmt->geoip.count; i++) {
+		char buf[3] = { stmt->geoip.cc[i][0], stmt->geoip.cc[i][1], '\0' };
+
+		json_array_append_new(cc, json_string(buf));
+	}
+
+	return nft_json_pack("{s:{s:s, s:b, s:o}}", "geoip",
+			     "dir", stmt->geoip.flags & NFT_GEOIP_F_DST ?
+				    "daddr" : "saddr",
+			     "inv", !!(stmt->geoip.flags & NFT_GEOIP_F_INV),
+			     "cc", cc);
+}
